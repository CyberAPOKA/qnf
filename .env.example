APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# When using a production DB dump locally, point to prod storage for missing files:
# STORAGE_FALLBACK_URL=http://91.99.50.35/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENTS_ACTIVE=true

YOUTUBE_API_KEY=

INSTAGRAM_ENABLED=false
INSTAGRAM_DRY_RUN=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v22.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_DEFAULT_STORY_AUDIO_PATH=
INSTAGRAM_OWN_USERNAME=qnfporto
INSTAGRAM_QUEUE=default
INSTAGRAM_STORY_DURATION_SECONDS=15
INSTAGRAM_CAPTION_HASHTAGS=#qnf,#qnfporto,#futebol

WHATSAPP_ACTIVE=false
WHATSAPP_PLAYER_ACTIVE=false
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_GROUP_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_COMMAND_COOLDOWN_SECONDS=3600
WHATSAPP_COMMANDS_GLOBAL_COOLDOWN_SECONDS=3600
WHATSAPP_LINEUP_COOLDOWN_SECONDS=3600
WHATSAPP_LINEUP_UNLIMITED_PHONE=555199304836
WHATSAPP_LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/whatsapp
WHATSAPP_WEBHOOK_TIMEOUT_MS=120000

FISH_AUDIO_ENABLED=false
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_LULA=
FISH_AUDIO_VOICE_BOLSONARO=
FISH_AUDIO_VOICE_NEYMAR=
DRAFT_NARRATOR_VOICE=lula

# GenerateDraftNarrationsJob can run longer than the default 90s.
# Keep this above the job timeout (540s) to avoid duplicate queue releases.
DB_QUEUE_RETRY_AFTER=600

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=123456
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
